{
    "name": "@soundretouch/api",
    "version": "1.6.0",
    "description": "Unofficial TypeScript API wrapper for managing Bose SoundTouch devices.",
    "keywords": [
        "bose",
        "soundtouch",
        "soundtouch-api",
        "speaker",
        "audio",
        "web-api",
        "websocket",
        "mdns",
        "bonjour"
    ],
    "homepage": "https://github.com/RemcoS2000/soundretouch-api/",
    "bugs": {
        "url": "https://github.com/RemcoS2000/soundretouch-api/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RemcoS2000/soundretouch-api.git"
    },
    "license": "MIT",
    "author": "RemcoS2000",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./device": {
            "types": "./dist/index.device.d.ts",
            "import": "./dist/index.device.js",
            "default": "./dist/index.device.js"
        },
        "./discovery": {
            "types": "./dist/index.discovery.d.ts",
            "import": "./dist/index.discovery.js",
            "default": "./dist/index.discovery.js"
        },
        "./package.json": "./package.json"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "architecture": "depcruise --config .dependency-cruiser.cjs src index.ts index.device.ts index.discovery.ts",
        "build": "tsc -p tsconfig.build.json",
        "clean": "rimraf dist",
        "duplication": "jscpd --config .jscpd.json src",
        "format": "prettier --write .",
        "format:check": "prettier --check src test scripts '*.ts' '*.js' '*.json' '*.md' .dependency-cruiser.cjs .jscpd.json .github/workflows .prettierrc",
        "lint": "eslint .",
        "prepare": "husky",
        "prepublishOnly": "npm run build",
        "quality:test": "node scripts/check-quality-tools.mjs",
        "smoke": "tsx scripts/smoke.ts",
        "start": "tsx index.ts",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "unused": "knip",
        "verify": "npm run format:check && npm run lint && npm run typecheck && npm run quality:test && npm run architecture && npm run unused && npm run duplication && npm run test:coverage && npm run build"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,yml,yaml,md}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "bonjour-service": "^1.4.4",
        "debug": "^4.4.3",
        "fast-xml-parser": "^5.11.2"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/debug": "^4.1.13",
        "@types/node": "^26.6.5",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "@vitest/coverage-v8": "^5.0.5",
        "dependency-cruiser": "^18.6.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^65.3.6",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-unused-imports": "^4.4.1",
        "husky": "^9.1.7",
        "jscpd": "^5.4.1",
        "knip": "^6.41.0",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "prettier-plugin-packagejson": "^3.0.2",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
        "vitest": "^5.0.5"
    }
}
